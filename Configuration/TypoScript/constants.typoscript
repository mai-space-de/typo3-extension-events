# mai_events TypoScript Constants

plugin.tx_maievents {
    view {
        templateRootPaths {
            0 = EXT:mai_events/Resources/Private/Templates/
        }
        partialRootPaths {
            0 = EXT:mai_events/Resources/Private/Partials/
        }
        layoutRootPaths {
            0 = EXT:mai_events/Resources/Private/Layouts/
        }
    }
    settings {
        defaultViewMode = month
        listLimit = 10
    }
}
