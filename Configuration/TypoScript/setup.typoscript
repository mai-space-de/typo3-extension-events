# mai_events TypoScript Setup

plugin {
    tx_maievents {
        view {
            templateRootPaths {
                0 = {$plugin.tx_maievents.view.templateRootPaths.0}
            }
            partialRootPaths {
                0 = {$plugin.tx_maievents.view.partialRootPaths.0}
            }
            layoutRootPaths {
                0 = {$plugin.tx_maievents.view.layoutRootPaths.0}
            }
        }
        settings {
            defaultViewMode = {$plugin.tx_maievents.settings.defaultViewMode}
            listLimit = {$plugin.tx_maievents.settings.listLimit}
        }
    }
    tx_maievents_registration {
        view {
            templateRootPaths {
                0 = {$plugin.tx_maievents.view.templateRootPaths.0}
            }
            partialRootPaths {
                0 = {$plugin.tx_maievents.view.partialRootPaths.0}
            }
            layoutRootPaths {
                0 = {$plugin.tx_maievents.view.layoutRootPaths.0}
            }
        }
    }
}

# Content element: Events View
tt_content {
    mai_events_view = FLUIDTEMPLATE
    mai_events_view {
        file = EXT:mai_events/Resources/Private/Templates/Calendar/Month.html
        partialRootPaths {
            0 = {$plugin.tx_maievents.view.partialRootPaths.0}
        }
        layoutRootPaths {
            0 = {$plugin.tx_maievents.view.layoutRootPaths.0}
        }
        dataProcessing {
            10 = Maispace\MaiEvents\DataProcessor\EventsDataProcessor
            10 {
                targetVariable = events
                viewMode = TEXT
                viewMode {
                    data = flexform:settings.viewMode
                    ifEmpty = month
                }
                listLimit = TEXT
                listLimit {
                    data = flexform:settings.listLimit
                    ifEmpty = 10
                }
            }
        }
    }
}
