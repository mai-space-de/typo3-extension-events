# mai_events TypoScript Setup

plugin {
    tx_maievents {
        persistence {
            storagePid = {$plugin.tx_maievents.persistence.storagePid}
        }
        view {
            templateRootPaths {
                0 = {$plugin.tx_maievents.view.templateRootPaths.0}
            }
            partialRootPaths {
                0 = {$plugin.tx_maievents.view.partialRootPaths.0}
            }
            layoutRootPaths {
                0 = {$plugin.tx_maievents.view.layoutRootPaths.0}
            }
        }
        settings {
            defaultViewMode = {$plugin.tx_maievents.settings.defaultViewMode}
            viewMode = {$plugin.tx_maievents.settings.defaultViewMode}
            listLimit = {$plugin.tx_maievents.settings.listLimit}
        }
    }
    tx_maievents_list {
        persistence {
            storagePid = {$plugin.tx_maievents.persistence.storagePid}
        }
        view {
            templateRootPaths {
                0 = {$plugin.tx_maievents.view.templateRootPaths.0}
            }
            partialRootPaths {
                0 = {$plugin.tx_maievents.view.partialRootPaths.0}
            }
            layoutRootPaths {
                0 = {$plugin.tx_maievents.view.layoutRootPaths.0}
            }
        }
        settings {
            defaultViewMode = {$plugin.tx_maievents.settings.defaultViewMode}
            viewMode = {$plugin.tx_maievents.settings.defaultViewMode}
            listLimit = {$plugin.tx_maievents.settings.listLimit}
        }
    }
    tx_maievents_registration {
        view {
            templateRootPaths {
                0 = {$plugin.tx_maievents.view.templateRootPaths.0}
            }
            partialRootPaths {
                0 = {$plugin.tx_maievents.view.partialRootPaths.0}
            }
            layoutRootPaths {
                0 = {$plugin.tx_maievents.view.layoutRootPaths.0}
            }
        }
    }
}

# Shared FlexForm view-mode resolver (GET override applied separately via CASE key / PHP).
lib.mai_events_flexformViewMode = TEXT
lib.mai_events_flexformViewMode {
    data = flexform:settings.viewMode
    ifEmpty = month
}

# Content element: Events View (FullCalendar)
# Wrapped as COA_INT so this block always re-renders per request — its output
# depends on tx_maievents_view/tx_maievents_date GET parameters, which are
# excluded from cHash calculation (see ext_localconf.php) and must therefore
# never be served from the full-page cache.
tt_content {
    mai_events_view = COA_INT
    mai_events_view {
        10 = FLUIDTEMPLATE
        10 {
            file = EXT:mai_events/Resources/Private/Templates/Calendar/FullCalendar.html
            partialRootPaths {
                0 = {$plugin.tx_maievents.view.partialRootPaths.0}
            }
            layoutRootPaths {
                0 = {$plugin.tx_maievents.view.layoutRootPaths.0}
            }
            dataProcessing {
                10 = Maispace\MaiEvents\DataProcessor\EventsDataProcessor
                10 {
                    targetVariable = calendar
                    viewMode < lib.mai_events_flexformViewMode
                    listLimit = TEXT
                    listLimit {
                        data = flexform:settings.listLimit
                        ifEmpty = 10
                    }
                    categoryUid = TEXT
                    categoryUid {
                        data = flexform:settings.categoryUid
                        ifEmpty = 0
                    }
                }
            }
        }
    }

    maispace_events_list = USER
    maispace_events_list {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        vendorName = Maispace
        extensionName = MaiEvents
        pluginName = List
        controller = Events
        action = list
    }
}
